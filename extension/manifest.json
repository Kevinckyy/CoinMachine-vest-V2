{
  "manifest_version": 3,
  "name": "Vest Fleet · 云端执行器",
  "version": "1.7.0",
  "description": "将本浏览器的 Vest 账户和经确认的操作回执同步到本机节点桥。",
  "permissions": ["storage", "activeTab", "alarms", "scripting"],
  "host_permissions": ["https://next.vestmarkets.com/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "Vest Fleet 节点连接"},
  "content_scripts": [{
    "matches": ["https://next.vestmarkets.com/*"],
    "js": ["core.js", "account-cards.js", "stop-protection.js", "profit-claim.js", "history.js", "vest-page.js", "content.js"],
    "run_at": "document_idle"
  }],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}
}
